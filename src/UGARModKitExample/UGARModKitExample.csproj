<Project Sdk="Microsoft.NET.Sdk">

  <!-- Template for a mod that uses UGAR ModKit. Copy this folder, rename the project, change the GUID in Plugin.cs. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>UGARModKitExample</AssemblyName>
    <RootNamespace>UGARModKitExample</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Ultimate General American Revolution</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- The kit as installed by the mod pack. Inside this repo you can use a ProjectReference to ..\UGARModKit instead. -->
    <Reference Include="$(GameDir)\BepInEx\plugins\UGARModKit\UGARModKit.dll" Private="false" Condition="Exists('$(GameDir)\BepInEx\plugins\UGARModKit\UGARModKit.dll')" />
    <ProjectReference Include="..\UGARModKit\UGARModKit.csproj" Private="false" Condition="!Exists('$(GameDir)\BepInEx\plugins\UGARModKit\UGARModKit.dll')" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>

</Project>
